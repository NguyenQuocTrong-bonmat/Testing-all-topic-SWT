{
  "name": "playwright-six-topics-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "visual:baseline": "playwright test --project=visual --update-snapshots",
    "test:ai": "playwright test --project=ai-assisted",
    "test:mobile": "playwright test --project=mobile-android --project=mobile-ios-profile",
    "test:performance": "playwright test --project=performance",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}